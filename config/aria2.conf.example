# aria2 配置示例
# 复制为 config/aria2.conf 后按需修改
# 路径都相对于「程序目录」（start.ps1 会把工作目录切到程序目录），
# 这样整个文件夹换一台电脑、换一个盘符都不用改配置。

# 下载目录
dir=downloads

# 单服务器最大连接数与分片数（aria2 上限 16）
split=16
max-connection-per-server=16
min-split-size=1M

# 不做预分配，避免大文件等待
file-allocation=none

# 断点续传会话
input-file=config/aria2.session
save-session=config/aria2.session

# 日志（留空则不写日志）
log=logs/aria2.log

# HTTPS 证书：吊销检查在部分网络下会失败，可改用 Mozilla CA bundle
# ca-certificate=config/cacert.pem
check-certificate=true

# RPC（本机使用）
enable-rpc=true
rpc-listen-all=false
rpc-listen-port=6800
rpc-secret=change-me-to-a-random-string

# 完成后不保留控制文件
force-save=false
