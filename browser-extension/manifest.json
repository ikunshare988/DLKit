{
  "manifest_version": 3,
  "name": "DLKit 浏览器接管",
  "version": "1.0.1",
  "description": "右键用 DLKit 下载，或把浏览器下载交给 DLKit。",
  "key": "",
  "permissions": ["alarms", "contextMenus", "downloads", "nativeMessaging", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "DLKit 浏览器接管"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
